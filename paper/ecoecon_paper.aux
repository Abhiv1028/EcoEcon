\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Network structure analysis. Left: keystone sector ranking, 2006 pre-crisis peak (technical coefficient normalization). Finance correctly identified as third most central sector. Right: spectral gap across both episodes, showing monotonic pre-crisis decline before 2008 but no trend before 2020.}}{9}{figure.caption.7}\protected@file@percent }
\newlabel{fig:network}{{5}{9}{Network structure analysis. Left: keystone sector ranking, 2006 pre-crisis peak (technical coefficient normalization). Finance correctly identified as third most central sector. Right: spectral gap across both episodes, showing monotonic pre-crisis decline before 2008 but no trend before 2020}{figure.caption.7}{}}
