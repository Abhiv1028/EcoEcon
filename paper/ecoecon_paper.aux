\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Ecological signal behavior across episodes. Kendall $\tau $ computed over pre-crisis years. For the 2020 negative control, theory predicts no significant trend (i.e., $|\tau |$ should be small and $p$ large).}}{5}{table.caption.2}\protected@file@percent }
\newlabel{tab:signals}{{2}{5}{Ecological signal behavior across episodes. Kendall $\tau $ computed over pre-crisis years. For the 2020 negative control, theory predicts no significant trend (i.e., $|\tau |$ should be small and $p$ large)}{table.caption.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Ecological early warning signals, 2008 GFC episode. Red shading indicates crisis period (Dec 2007--Jun 2009). Verdicts indicate whether each signal moved in the theoretically predicted direction pre-crisis. Two of five signals (spectral gap, housing starts variance) behaved as theorized.}}{6}{figure.caption.3}\protected@file@percent }
\newlabel{fig:signals}{{1}{6}{Ecological early warning signals, 2008 GFC episode. Red shading indicates crisis period (Dec 2007--Jun 2009). Verdicts indicate whether each signal moved in the theoretically predicted direction pre-crisis. Two of five signals (spectral gap, housing starts variance) behaved as theorized}{figure.caption.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.2}The 2020 Negative Control}{7}{subsection.3.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Signal comparison: 2008 GFC (endogenous fold, signal expected) versus 2020 COVID (exogenous shock, no signal expected). Left column: spectral gap. Right column: housing starts variance. Theory predicts the 2008 signals should trend toward risk; the 2020 signals should not. The contrast is consistent with theoretical predictions for both working signals.}}{7}{figure.caption.4}\protected@file@percent }
\newlabel{fig:negcontrol}{{2}{7}{Signal comparison: 2008 GFC (endogenous fold, signal expected) versus 2020 COVID (exogenous shock, no signal expected). Left column: spectral gap. Right column: housing starts variance. Theory predicts the 2008 signals should trend toward risk; the 2020 signals should not. The contrast is consistent with theoretical predictions for both working signals}{figure.caption.4}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.3}False Positive Analysis}{8}{subsection.3.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces False positive analysis. Spectral gap across all periods: 2008 episode (endogenous crisis), 2020 episode (exogenous shock), and two calm periods (post-GFC recovery 2010--2014; pre-COVID expansion 2015--2019). Zero false alarms in ten calm-period years.}}{8}{figure.caption.5}\protected@file@percent }
\newlabel{fig:fp}{{3}{8}{False positive analysis. Spectral gap across all periods: 2008 episode (endogenous crisis), 2020 episode (exogenous shock), and two calm periods (post-GFC recovery 2010--2014; pre-COVID expansion 2015--2019). Zero false alarms in ten calm-period years}{figure.caption.5}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.4}Trend Significance}{8}{subsection.3.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Kendall $\tau $ trend statistics. Left: 2008 GFC pre-crisis window (positive $\tau $ = rising toward risk). Right: 2020 negative control pre-crisis window. Theory predicts significant positive $\tau $ in the left panel for working signals, and non-significant $\tau $ in the right panel. Results are consistent with this prediction for spectral gap and housing starts variance.}}{9}{figure.caption.6}\protected@file@percent }
\newlabel{fig:kendall}{{4}{9}{Kendall $\tau $ trend statistics. Left: 2008 GFC pre-crisis window (positive $\tau $ = rising toward risk). Right: 2020 negative control pre-crisis window. Theory predicts significant positive $\tau $ in the left panel for working signals, and non-significant $\tau $ in the right panel. Results are consistent with this prediction for spectral gap and housing starts variance}{figure.caption.6}{}}
